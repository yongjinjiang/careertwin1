# Copy to .env.local (ignored by Git). Real values are never committed.
# Browser (public values only): Vite exposes only VITE_-prefixed names to the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Restricted runtime role only (careertwin1_app.<project-ref> on the transaction pooler), never postgres or service_role.
CAREERTWIN1_DATABASE_URL=
# PEM of the database CA (literal \n allowed). TLS is certificate-verified when set.
CAREERTWIN1_DATABASE_CA=

# Cloud validation harness only (scripts/test-m2-1-cloud.mjs); never used by the running API.
M21_TEST_SUPABASE_ADMIN_KEY=
